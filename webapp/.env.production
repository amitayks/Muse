# Production API base URL — the Cloudflare Worker that serves /api/v1/* and /media/*.
# Vite bakes this into the bundle at build time (VITE_ prefix = client-exposed).
# Not a secret: the worker URL is already visible in the shipped client.
# IMPORTANT: without this, builds fall back to a relative '' base and every API
# call hits the Pages SPA fallback (index.html) instead of the Worker.
VITE_API_URL=https://content-bot.keisarcontentcreator.workers.dev
